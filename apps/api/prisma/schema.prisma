generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPLOYEE
  MANAGER
  CUSTOMER
  ADMIN
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  NEW
  IN_KITCHEN
  READY
  CLOSED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  CASH
  CARD
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String? @unique
  phone        String?
  passwordHash String?
  pinHash      String?
  employeeCode String? @unique

  role     UserRole @default(EMPLOYEE)
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdOrders     Order[]           @relation("CreatedOrders")
  voidLogs          VoidLog[]
  openedStoreShifts StoreShift[]      @relation("OpenedStoreShifts")
  closedStoreShifts StoreShift[]      @relation("ClosedStoreShifts")
  employeeSessions  EmployeeSession[]
  tableLocks        TableLock[]       @relation("UserTableLocks")

  @@index([role])
  @@index([isActive])
}

model StoreShift {
  id     String      @id @default(cuid())
  status ShiftStatus @default(OPEN)

  businessDate DateTime
  terminalCode String

  openedAt   DateTime @default(now())
  openedById String
  openedBy   User     @relation("OpenedStoreShifts", fields: [openedById], references: [id])

  closedAt   DateTime?
  closedById String?
  closedBy   User?     @relation("ClosedStoreShifts", fields: [closedById], references: [id])

  openingCashCents Int  @default(0)
  closingCashCents Int?

  grossSalesCents Int @default(0)
  discountCents   Int @default(0)
  voidedCents     Int @default(0)
  taxCents        Int @default(0)
  tipCents        Int @default(0)
  netSalesCents   Int @default(0)

  cashSalesCents Int @default(0)
  cardSalesCents Int @default(0)
  orderCount     Int @default(0)

  notes   String?
  pdfPath String?

  orders           Order[]
  employeeSessions EmployeeSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([businessDate])
  @@index([openedById])
}

model EmployeeSession {
  id           String  @id @default(cuid())
  employeeId   String
  storeShiftId String?

  loginAt      DateTime  @default(now())
  logoutAt     DateTime?
  breakMinutes Int       @default(0)
  notes        String?

  employee   User        @relation(fields: [employeeId], references: [id])
  storeShift StoreShift? @relation(fields: [storeShiftId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([storeShiftId])
  @@index([loginAt])
}

model MenuCategory {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  items MenuItem[]
}

model MenuItem {
  id          String  @id @default(cuid())
  categoryId  String
  name        String
  slug        String  @unique
  description String?
  priceCents  Int
  taxable     Boolean @default(true)
  isActive    Boolean @default(true)

  // Image for every item (store URL in DB)
  imageUrl String?
  imageAlt String?

  category MenuCategory @relation(fields: [categoryId], references: [id])

  // Opposite relation
  orderItems OrderItem[]
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   Int
  type          OrderType
  tableNumber   String?
  customerName  String?
  customerPhone String?
  deliveryAddr  String?
  status        OrderStatus @default(NEW)

  subtotalCents Int @default(0)
  taxCents      Int @default(0)
  tipCents      Int @default(0)
  totalCents    Int @default(0)
  payments Payment[]

  paymentStatus PaymentStatus  @default(UNPAID)
  paymentMethod PaymentMethod?

  sentToKitchenAt DateTime?
  closedAt        DateTime?

  createdById String
  createdBy   User   @relation("CreatedOrders", fields: [createdById], references: [id])

  items    OrderItem[]
  voidLogs VoidLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NEW: discount per order
  discountCents Int @default(0)

  storeShiftId String?
  storeShift   StoreShift? @relation(fields: [storeShiftId], references: [id])

  // helpful for tracking which tablet created the order
  terminalCode String?

  @@index([status])
  @@index([createdAt])
  @@index([storeShiftId])
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])

  method      PaymentMethod
  amountCents Int

  // optional for cash
  amountReceivedCents Int?
  changeGivenCents    Int?

  createdAt DateTime @default(now())
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  menuItemId String

  // Snapshots (menu changes won't affect past orders)
  nameSnapshot   String
  basePriceCents Int

  qty   Int     @default(1)
  notes String?

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  modifiers OrderItemModifier[]
}

model OrderItemModifier {
  id              String @id @default(cuid())
  orderItemId     String
  nameSnapshot    String
  priceDeltaCents Int    @default(0)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
}

model VoidLog {
  id          String   @id @default(cuid())
  orderId     String
  orderItemId String?
  reason      String
  voidedById  String
  voidedAt    DateTime @default(now())

  order    Order @relation(fields: [orderId], references: [id])
  voidedBy User  @relation(fields: [voidedById], references: [id])
}

model TableLock {
  id          String @id @default(cuid())
  tableNumber Int    @unique

  lockedById String
  lockedBy   User   @relation("UserTableLocks", fields: [lockedById], references: [id])

  lockedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}
