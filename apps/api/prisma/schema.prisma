generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPLOYEE
  CUSTOMER
  ADMIN
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  NEW
  IN_KITCHEN
  READY
  CLOSED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  CASH
  CARD
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String? @unique
  phone        String?
  passwordHash String?
  pinHash      String?

  role     UserRole @default(EMPLOYEE)
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdOrders Order[]     @relation("CreatedOrders")
  voidLogs      VoidLog[]
  shifts        Shift[]
  tableLocks    TableLock[] @relation("UserTableLocks")

  @@index([role])
  @@index([isActive])
}

model Shift {
  id     String      @id @default(cuid())
  status ShiftStatus @default(OPEN)

  // who is working this shift
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // which tablet/register (simple string for now)
  terminalCode String

  openedAt DateTime  @default(now())
  closedAt DateTime?

  // optional cash tracking
  openingCashCents Int  @default(0)
  closingCashCents Int?

  // snapshot totals saved at close (so reports are fast later)
  grossSalesCents Int @default(0)
  discountCents   Int @default(0)
  voidedCents     Int @default(0)
  taxCents        Int @default(0)
  tipCents        Int @default(0)
  netSalesCents   Int @default(0)

  cashSalesCents Int @default(0)
  cardSalesCents Int @default(0)
  orderCount     Int @default(0)

  // link orders to this shift
  orders Order[]

  @@index([openedAt])
  @@index([status])
  @@index([userId])
}

model MenuCategory {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  items MenuItem[]
}

model MenuItem {
  id          String  @id @default(cuid())
  categoryId  String
  name        String
  slug        String  @unique
  description String?
  priceCents  Int
  taxable     Boolean @default(true)
  isActive    Boolean @default(true)

  // Image for every item (store URL in DB)
  imageUrl String?
  imageAlt String?

  category MenuCategory @relation(fields: [categoryId], references: [id])

  // Opposite relation
  orderItems OrderItem[]
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   Int
  type          OrderType
  tableNumber   String?
  customerName  String?
  customerPhone String?
  deliveryAddr  String?
  status        OrderStatus @default(NEW)

  subtotalCents Int @default(0)
  taxCents      Int @default(0)
  tipCents      Int @default(0)
  totalCents    Int @default(0)

  paymentStatus PaymentStatus  @default(UNPAID)
  paymentMethod PaymentMethod?

  sentToKitchenAt DateTime?
  closedAt        DateTime?

  createdById String
  createdBy   User   @relation("CreatedOrders", fields: [createdById], references: [id])

  items    OrderItem[]
  voidLogs VoidLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NEW: discount per order
  discountCents Int @default(0)

  // NEW: link order to a shift
  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  // helpful for tracking which tablet created the order
  terminalCode String?

  @@index([status])
  @@index([createdAt])
  @@index([shiftId])
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  menuItemId String

  // Snapshots (menu changes won't affect past orders)
  nameSnapshot   String
  basePriceCents Int

  qty   Int     @default(1)
  notes String?

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  modifiers OrderItemModifier[]
}

model OrderItemModifier {
  id              String @id @default(cuid())
  orderItemId     String
  nameSnapshot    String
  priceDeltaCents Int    @default(0)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
}

model VoidLog {
  id          String   @id @default(cuid())
  orderId     String
  orderItemId String?
  reason      String
  voidedById  String
  voidedAt    DateTime @default(now())

  order    Order @relation(fields: [orderId], references: [id])
  voidedBy User  @relation(fields: [voidedById], references: [id])
}

model TableLock {
  id          String @id @default(cuid())
  tableNumber Int    @unique

  lockedById String
  lockedBy   User   @relation("UserTableLocks", fields: [lockedById], references: [id])

  lockedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}
